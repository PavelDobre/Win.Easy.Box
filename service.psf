$install_Click={
	#TODO: Place custom script here
	New-Item -ItemType Directory -Force "C:\ProgramData\easybox" | Out-Null
	
	Copy-Item $singbox "C:\Program Files\sing-box\sing-box.exe" -Force
	Copy-Item ".\config.json" "C:\ProgramData\sing-box\config.json" -Force
	
	sc.exe create sing-box `
		   binPath= '"C:\Program Files\sing-box\sing-box.exe" run -c "C:\ProgramData\sing-box\config.json"' `
		   start= demand `
		   DisplayName= "sing-box"
	
	sc.exe description sing-box "sing-box TUN proxy service"
}
