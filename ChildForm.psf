$install_Click = {
	$install.BackColor = 'Orange'
	try
	{
		New-Item -ItemType Directory -Force $logDir | Out-Null
		
		$existingService = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue
		
		if ($existingService)
		{
			throw "Service already exists: $ServiceName"
		}
		
		Invoke-Nssm @("install", $ServiceName, $singbox)
		
		Invoke-Nssm @("set", $ServiceName, "Application", $singbox)
		Invoke-Nssm @("set", $ServiceName, "AppParameters", "run -c $serviceconfigfile")
		Invoke-Nssm @("set", $ServiceName, "AppDirectory", $baseDir)
		
		Invoke-Nssm @("set", $ServiceName, "DisplayName", $DisplayName)
		Invoke-Nssm @("set", $ServiceName, "Description", "EasyBox service")
		Invoke-Nssm @("set", $ServiceName, "Start", "SERVICE_DEMAND_START")
		
		Invoke-Nssm @("set", $ServiceName, "AppStdout", $stdoutLog)
		Invoke-Nssm @("set", $ServiceName, "AppStderr", $stderrLog)
		
		Invoke-Nssm @("set", $ServiceName, "AppRotateFiles", "1")
		Invoke-Nssm @("set", $ServiceName, "AppRotateOnline", "1")
		Invoke-Nssm @("set", $ServiceName, "AppRotateBytes", "10485760")
		
		Invoke-Nssm @("set", $ServiceName, "AppExit", "Default", "Restart")
		Invoke-Nssm @("set", $ServiceName, "AppThrottle", "1500")
		
	}
	catch
	{
		[System.Windows.Forms.MessageBox]::Show("Failed to create service:`r`n$($_.Exception.Message)")
	}
	$install.BackColor = 'AntiqueWhite'
}



$delservice_Click = {
	try
	{
		$existingService = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue
		
		if (-not $existingService)
		{
			[System.Windows.Forms.MessageBox]::Show("Service not found: $ServiceName")
			return
		}
		
		if ($existingService.Status -ne "Stopped")
		{
			Stop-Service -Name $ServiceName -Force
			Start-Sleep -Seconds 2
		}
		
		Invoke-Nssm @("remove", $ServiceName, "confirm")
		Start-Sleep -Seconds 2
		
		[System.Windows.Forms.MessageBox]::Show("Service removed: $ServiceName")
	}
	catch
	{
		[System.Windows.Forms.MessageBox]::Show("Failed to remove service:`r`n$($_.Exception.Message)")
	}
}



$button2_Click={
	try
	{
		$button2.BackColor = 'Orange'
		$profilefile = Join-Path $profilesDir $label1.Text		
		$script:SingBoxConfigPath = $configfile
		$script:SingBoxProfileName = $label1.Text
		
		Build-SingboxConfig -BaseConfigPath $baseconfigfile -ProfilePath $profilefile -OutputPath $configfile -ForceRouteFinalToProxy
		
		if (-not (Test-Path $logDir))
		{
			New-Item -ItemType Directory -Path $logDir | Out-Null
		}
		
		try
		{
			$service = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue
			if ($service -and $service.Status -eq "Running")
			{
				Stop-Service -Name $ServiceName -Force
				Start-Sleep -Seconds 1
			}
			Copy-Item $configfile $serviceconfigfile -Force -ErrorAction Stop
			Start-Service -Name $ServiceName
			Start-Sleep -Milliseconds 500
			Update-SingBoxServiceStatus
		}
		catch
		{
			
			[System.Windows.Forms.MessageBox]::Show(
				"Не удалось скопировать файл:`r`n$($_.Exception.Message)"
			)
		}
		
	}
	catch
	{
		[System.Windows.Forms.MessageBox]::Show(
			"Не удалось запустить службу:`r`n$($_.Exception.Message)"
		)
		Hide-ExternalIpLabels
	}
	$button2.BackColor = 'LightGreen'
}

$button1_Click={
	
	try
	{
		Stop-Service -Name $ServiceName -Force
		
		Start-Sleep -Milliseconds 500
		
		Update-SingBoxServiceStatus
		Hide-ExternalIpLabels
	}
	catch
	{
		[System.Windows.Forms.MessageBox]::Show(
			"Не удалось остановить службу:`r`n$($_.Exception.Message)"
		)
	}
	
}

$addProf_Click={
	if (Show-addSubscriptionForm_psf -eq 'OK')
	{
		$baseDir = [System.AppDomain]::CurrentDomain.BaseDirectory
		$profilesDir = Join-Path $baseDir "profiles"
		if (-not (Test-Path -LiteralPath $profilesDir))
		{
			[System.IO.Directory]::CreateDirectory($profilesDir) | Out-Null
		}
		
		$listBox1.Items.Clear()
		Get-ChildItem -Path $profilesDir -File | ForEach-Object {
			$listbox1.Items.Add($_.Name)
		}
	}
	
}


$delProf_Click={
	if (Show-DeleteProfileForm_psf -eq 'OK')
	{
		$listBox1.Items.Clear()
		Get-ChildItem -Path $profilesDir -File | ForEach-Object {
			$listbox1.Items.Add($_.Name)
		}
	}
	
}

