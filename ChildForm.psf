$labelУдалитьСлужбу_Click={
	$result = [System.Windows.Forms.MessageBox]::Show(
		"Удалить службу?",
		"Подтверждение удаления",
		[System.Windows.Forms.MessageBoxButtons]::YesNo,
		[System.Windows.Forms.MessageBoxIcon]::Warning
	)
	
	if ($result -eq [System.Windows.Forms.DialogResult]::Yes)
	{
		try
		{
			$existingService = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue
			
			if (-not $existingService)
			{
				[System.Windows.Forms.MessageBox]::Show("Служба не найдена: $ServiceName")
				return
			}
			
			if ($existingService.Status -ne "Stopped")
			{
				Stop-Service -Name $ServiceName -Force
				Start-Sleep -Seconds 2
			}
			
			Invoke-Nssm @("remove", $ServiceName, "confirm")
			Start-Sleep -Seconds 2
			
			[System.Windows.Forms.MessageBox]::Show("Служба удалена: $ServiceName")
		}
		catch
		{
			[System.Windows.Forms.MessageBox]::Show("Ошибка:`r`n$($_.Exception.Message)")
		}
	}
	else
	{
	}
	
}

